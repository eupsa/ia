# Apenas para produção. Use um domínio com DNS apontando para o IP público da VM.
DOMAIN=chat.seudominio.com
AUTH_USER=admin
# Gere com: docker run --rm -it caddy:2.10-alpine caddy hash-password
# Preserve as aspas simples para impedir a interpolação dos sinais de dólar.
AUTH_PASSWORD_HASH='COLE_O_HASH_BCRYPT_AQUI'

# API sem frontend (compose.api.yaml): gere com openssl rand -hex 32.
# API_KEY=COLE_UMA_CHAVE_ALEATORIA_AQUI
